@startuml

hide empty members

class Network {
    - id : String
    - name : String
    - href : String
    - company : String[]
    - gbfsHref : String
    - ebikes : boolean
}

class Location {
    - city : String
    - country : Strings
}

class Favourite {
    + networkId : String
}

class NetworksResponse {

}

class NetworkResponse {
    
}

class Station {
    - id : String
    - name : String
    - latitude : double
    - longitude : double
    - timestamp : String
    - freeBikes : int
    - emptySlots : int
}

class Incident {
    - id: int
    - idStation: String
    - amount: int
    - type: String
    - typeId: IncidentType
}

enum IncidentType {
    BIKE
    STATION
    OTHER
}

Network *--> "1" Location : location
Network *--> "0..*" Station : stations
NetworksResponse *--> "*" Network : networks
NetworkResponse *--> "1" Network : network

@enduml