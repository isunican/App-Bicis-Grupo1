@startuml architecture

hide empty members

MainView ..|> IMainContract.View
MainPresenter ..|> IMainContract.Presenter
MainView --> INetworksRepository : repository
ApiNetworksRepository ..|> INetworksRepository
JsonNetworksRepository ..|> INetworksRepository
MainView --> MainPresenter : presenter
MainPresenter --> MainView : view
MainView ..> InfoView : <<use>>
MainView ..> RedDetailsView : <<use>>
RedDetailsView ..> StationDetailsView : <<use>>

RedDetailsView ..|> IRedDetailsContract.View
RedDetailsPresenter ..|> IRedDetailsContract.Presenter
RedDetailsView --> INetworksRepository : repository
RedDetailsView --> RedDetailsPresenter : presenter
RedDetailsPresenter --> RedDetailsView : view
MainView --> IFavouriteDAO : favouriteDAO
MainView ..> AppDatabase : <<use>>

StationDetailsView ..|> IStationDetailsContract.View
StationDetailsPresenter ..|> IStationDetailsContract.Presenter
StationDetailsView --> StationDetailsPresenter : presenter
StationDetailsPresenter --> StationDetailsView : view
StationDetailsPresenter --> IIncidentDAO : <<use>>


class MainView {
}

class MainPresenter {
    -load()
}

class InfoView

class StationDetailsView{
}

class StationDetailsPresenter {
    -load()
}


class RedDetailsView {
    +onClickFilterMoreThanDistance()
    +onClickFilterLessThanDistance()
}
class RedDetailsPresenter {
    -load()
}

class AppDatabase {
    + favouriteDAO() : IFavouriteDAO
    + getDatabase(context : Context) : AppDatabase
}

class ApiNetworksRepository
class JsonNetworksRepository

interface IFavouriteDAO {
    + insertarFavorito(favorito : Favourite)
}

interface IMainContract.View {
    + init()
    + getNetworksRepository() : INetworksRepository
    + showNetworks(networks : List<Network>)
    + showLoadCorrect(networks : int)
    + showLoadError()
    + showNetworkDetails(network : Network)
    + showInfoActivity()
    + getFavouriteDAO() : IFavouriteDAO
    + showMarkedAsFavorite(network : Network)
    + updateFavorites(favoriteNetworkIds : Set<String>)
}

interface IMainContract.Presenter {
    + init(View view)
    + onNetworkClicked(network : Network)
    + onMenuInfoClicked()
    + onFavoriteClicked(network : Network)
}

interface IRedDetailsContract.View {
    + init()
    + getNetworksRepository() : INetworksRepository
    + showStations(stations : List<Station>)
    + showLoadCorrect(stations : int)
    + showLoadError()
    + showRedError()
    + showLocationError()
    + showNoStationsInRangeError()
    + getContext() : Context
    + showStationDetails(station: Station)
}

interface IRedDetailsContract.Presenter {
    + init(View view)
    + onStationClicked(Station station)
    + onFilterClick(distance : String, filter : DistanceFilter)
}

interface INetworksRepository {
    + requestNetworks(cb : NetworksCallback )
    + requestNetwork(cb: NetworkDetailsCallback , networkId : String)
}

interface NetworksCallback {
    + onSuccess(networks : List<Network>)
    + onFailure(e : Throwable)
}

interface NetworkDetailsCallback {
    + onSuccess(network : Networ)
    + onFailure(e : Throwable)
}

enum DistanceFilter {
    LESS_THAN
    MORE_THAN
}

interface IStationDetailsContract.Presenter {
    + init(View view, Station station, AppDatabase db)
    + registrarIncidencia(IncidentType type, String texto)
    + onDestroy()
}

interface IStationDetailsContract.View {
    + init()
    + showDatabaseError()
    + Context getContext(): Context
    + showEmptyIssueError()
    + onDestroy()
}

interface IIncidentDAO {
    + insertarIncidencia(Incident incidencia) : long
    + obtenerIncidenciasPorEstacion(String id) : List<Incident>
}

enum IncidentType {
    BIKE("Bicicleta defectuosa")
    STATION("Estación dañada")
    OTHER("")
    --
    - description : String
}

@enduml
