<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.details.StationDetailsView">

    <TextView
        android:id="@+id/tvFreeSlots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/empty_slots"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvUsedSlots"
        app:layout_constraintTop_toBottomOf="@+id/tvUsedSlots" />

    <TextView
        android:id="@+id/tvLogintude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/longitude"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvLatitude"
        app:layout_constraintTop_toBottomOf="@+id/tvLatitude" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.Bicis.Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <TextView
        android:id="@+id/tvStName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:text="Station Name"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
        android:id="@+id/tvLatitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/latitude"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvId"
        app:layout_constraintTop_toBottomOf="@+id/tvIdDisplay" />

    <TextView
        android:id="@+id/tvLatDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="88.88"
        app:layout_constraintStart_toEndOf="@+id/tvLatitude"
        app:layout_constraintTop_toTopOf="@+id/tvLatitude" />

    <TextView
        android:id="@+id/tvLongDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="88.88"
        app:layout_constraintStart_toEndOf="@+id/tvLogintude"
        app:layout_constraintTop_toTopOf="@+id/tvLogintude" />

    <TextView
        android:id="@+id/tvUsedSlots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/free_bikes"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvLogintude"
        app:layout_constraintTop_toBottomOf="@+id/tvLogintude" />

    <TextView
        android:id="@+id/tvUsedSlotsDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="88"
        app:layout_constraintStart_toEndOf="@+id/tvUsedSlots"
        app:layout_constraintTop_toTopOf="@+id/tvUsedSlots" />

    <TextView
        android:id="@+id/tvFreeSlotsDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="88"
        app:layout_constraintStart_toEndOf="@+id/tvFreeSlots"
        app:layout_constraintTop_toTopOf="@+id/tvFreeSlots" />

    <TextView
        android:id="@+id/tvId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/id"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvStName"
        app:layout_constraintTop_toBottomOf="@+id/tvStName" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/timestamp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvFreeSlots"
        app:layout_constraintTop_toBottomOf="@+id/tvFreeSlots" />

    <TextView
        android:id="@+id/tvIdDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="8041HDu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvId"
        app:layout_constraintTop_toBottomOf="@+id/tvId" />

    <TextView
        android:id="@+id/tvTimeDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="12:00 UTC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvTime"
        app:layout_constraintTop_toBottomOf="@+id/tvTime" />

    <ListView
        android:id="@+id/lvIncidences"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIncidences" />

    <TextView
        android:id="@+id/tvIncidences"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Incidences"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvTimeDisplay"
        app:layout_constraintTop_toBottomOf="@+id/btBotonIncidencia" />

    <ImageButton
        android:id="@+id/btBotonIncidencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/incidencia"
        android:src="@drawable/boton_incidencia"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.882"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTimeDisplay"
        app:layout_constraintVertical_bias="0.06"
        app:srcCompat="@drawable/boton_incidencia" />

    <Spinner
        android:id="@+id/spIncidencias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btBotonIncidencia"
        app:layout_constraintEnd_toEndOf="@+id/btBotonIncidencia"
        app:layout_constraintStart_toStartOf="@+id/btBotonIncidencia"
        app:layout_constraintTop_toTopOf="@+id/btBotonIncidencia" />

</androidx.constraintlayout.widget.ConstraintLayout>